<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MVVM.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <Color x:Key="BgRoot">#080607</Color>
        <Color x:Key="BgSurface">#100C0E</Color>
        <Color x:Key="BgSurfaceAlt">#181114</Color>
        <Color x:Key="BgElevated">#21161B</Color>
        <Color x:Key="BorderSoft">#3B232D</Color>
        <Color x:Key="Accent">#8C1936</Color>
        <Color x:Key="AccentHover">#B31F45</Color>
        <Color x:Key="TextStrong">#F8F5F6</Color>
        <Color x:Key="TextMuted">#BDAFB4</Color>

        <SolidColorBrush x:Key="BgRootBrush" Color="{StaticResource BgRoot}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="BgSurfaceAltBrush" Color="{StaticResource BgSurfaceAlt}"/>
        <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource TextStrong}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgRootBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="Border.panel-soft">
            <Setter Property="Background" Value="{StaticResource BgSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="TextBox, ComboBox, ListBox">
            <Setter Property="Background" Value="{StaticResource BgSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#24171C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2E1B23"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#25161D"/>
        </Style>

        <Style Selector="ListBox.chip-list">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="ListBox.chip-list > ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#24171C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style Selector="ListBox.chip-list > ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ListBox.card-list">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#170F12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="Border.hero">
            <Setter Property="Background" Value="#26141A"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.cover-sm">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#3C232D"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Border.cover-lg">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#3C232D"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Border.cover-now">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#3C232D"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Button.player-mode">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#24171C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        </Style>

        <Style Selector="Button.player-mode.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Slider.progress">
            <Setter Property="Height" Value="24"/>
        </Style>
    </Application.Styles>
</Application>
